{
  "name": "scholar",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.1.27"
  },
  "bin": {
    "mcp-scholar": "./src/server/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "build:server": "tsc --noEmit && bun build src/server/index.ts --compile --target=bun-windows-x64 --outfile build/scholar.exe",
    "build:ui": "bun scripts/build-ui.ts",
    "build:ui:dev": "UI_MINIFY=false bun -q build:ui",
    "build:pdf": "bun --cwd=scripts vendor-pdf-server",
    "build:vec": "bun --cwd=scripts build-vec0",
    "build:plugin": "bun --cwd=scripts build-plugin",
    "measure-bundle": "bun scripts/measure-bundle.ts",
    "serve": "bun --cwd=scripts start-server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@retorquere/bibtex-parser": "latest",
    "chart.js": "latest",
    "drizzle-orm": "latest",
    "fflate": "latest",
    "js-tiktoken": "latest",
    "koffi": "latest",
    "pdfjs-dist": "latest",
    "react": "latest",
    "react-dom": "latest",
    "reactive-context-toolkit": "github:zaynram/reactive-context-toolkit",
    "sqlite-vec": "latest",
    "ulidx": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.9.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "bun-types": "latest",
    "drizzle-kit": "latest",
    "typescript": "^5"
  },
  "scholar": {
    "bunSqliteVersion": "3.51.2",
    "bundledBunVersion": "1.3.11"
  }
}
