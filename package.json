{
    "name": "scholar",
    "version": "0.1.0",
    "type": "module",
    "private": true,
    "engines": { "bun": ">=1.1.27" },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test": "bun test src tests",
        "db:generate": "drizzle-kit generate",
        "build:server": "tsc --noEmit && bun build src/server/index.ts --target=bun --outfile=dist/server.js",
        "build:ui": "bun --silent scripts/build-ui",
        "build:ui:dev": "UI_MINIFY=false bun -q build:ui",
        "build:pdf": "bun --silent scripts/vendor-pdf-server",
        "build:pdf-bundle": "bun build src/vendor/pdf-server/dist/index.js --target=bun --outfile=dist/pdf-server/index.js && cp src/vendor/pdf-server/dist/mcp-app.html dist/pdf-server/mcp-app.html",
        "build:vec": "bun --silent scripts/build-vec0",
        "build": "bun --silent scripts/build-plugin",
        "build:linux": "SCHOLAR_BUILD_WIN=0 bun --silent run build",
        "measure-bundle": "bun --silent scripts/measure-bundle"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.29.0",
        "@retorquere/bibtex-parser": "latest",
        "chart.js": "latest",
        "drizzle-orm": "latest",
        "fflate": "latest",
        "js-tiktoken": "latest",
        "koffi": "latest",
        "pdfjs-dist": "latest",
        "react": "latest",
        "react-dom": "latest",
        "reactive-context-toolkit": "github:zaynram/reactive-context-toolkit",
        "sqlite-vec": "latest",
        "ulidx": "latest",
        "zod": "latest"
    },
    "devDependencies": {
        "@happy-dom/global-registrator": "^20.9.0",
        "@types/react": "latest",
        "@types/react-dom": "latest",
        "bun-types": "latest",
        "drizzle-kit": "latest",
        "typescript": "^5"
    },
    "scholar": { "bunSqliteVersion": "3.51.2", "bundledBunVersion": "1.3.11" }
}
