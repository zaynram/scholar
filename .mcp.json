{
  "mcpServers": {
    "scholar": {
      "command": "bun",
      "args": ["run", "start"],
      "env": {
        "SCHOLAR_RUNTIME_ROOT": "${HOME}/mcp-data/scholar/runtime",
        "SCHOLAR_OLLAMA_URL": "http://127.0.0.1:11434",
        "SCHOLAR_OLLAMA_EMBED_MODEL": "nomic-embed-text:v1.5",
        "SCHOLAR_OLLAMA_CHAT_MODEL": "qwen3:8b"
      }
    }
  }
}
