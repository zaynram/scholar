node_modules/
# Build outputs are ignored, EXCEPT the prebuilt vec0 sqlite-vec extensions that
# the source-sync marketplace install needs at runtime (resolveVec0Path's
# <root>/build/vendor/sqlite-vec/vec0.{so,dll} rung). Git cannot re-include a file
# under an ignored parent, so the path is un-ignored level-by-level. macOS
# (.dylib) is intentionally absent — source-sync on mac boots but fails at the
# first vector op (known partial; see HUMAN.md).
build/*
!build/vendor/
build/vendor/*
!build/vendor/sqlite-vec/
build/vendor/sqlite-vec/*
!build/vendor/sqlite-vec/vec0.so
!build/vendor/sqlite-vec/vec0.dll
dist/
out/
runtime/
*.db
*.db-journal
.DS_Store
.tmp-*

# Re-include the vendored pdf-server dist (cycle 6.2). The generic `dist/` rule
# above would otherwise hide src/vendor/pdf-server/dist/, which MUST be tracked
# so the packaging cycle can copy it verbatim into the .plugin archive.
!src/vendor/pdf-server/dist/
!src/vendor/pdf-server/dist/**

.claude/scheduled_tasks.lock
.claude/worktrees/**

# Compiled server binaries + platform staging dirs — build outputs, never commit.
bin/mcp-scholar
bin/mcp-scholar.exe
win32/
# Stray nested copy from a build script writing to a literal "home/" path.
home/
# Backup of the deleted build-plugin.test.ts, kept locally during the refactor.
build-plugin-test-old.ts
